function dotBusy(on){ $('#dot').classList.toggle('busy', on); }
async function fetchBoard(force){
  if (!force && (S.pending > 0 || S.batchTimer || Date.now() - S.lastWrite < 3500)) return;
  if (S.fetching) return;
  S.fetching = true; dotBusy(true);
  const w = S.writeSeq;
  try {
    const b = await gs('getBoard', S.viewDate, !!force);
    if (w !== S.writeSeq || S.pending > 0 || S.batchTimer) return;
    const rest = Object.assign({}, b); delete rest.syncedAt;
    const j = JSON.stringify(rest);
    S.online = true;
    $('#dot').classList.remove('off');
    $('#syncTxt').textContent = '最後同步 '+nowTime();
    if (!S.viewDate) saveLocalSnap(j);
    if (j !== S.lastJson) { S.lastJson = j; S.board = rest; renderAll(); }
  } catch(e) {
    S.online = false;
    $('#dot').classList.add('off');
    $('#syncTxt').textContent = '連線中斷，稍後自動重試（上次 '+(S.board?'已有資料':'尚無資料')+'）';
    if (!S.board) $('#tblWrap').innerHTML = '<div class="empty"><svg><use href="#i-cloud"/></svg><p>'+esc(errMsg(e))+'</p></div>';
  } finally { S.fetching = false; dotBusy(false); }
}
