.fish-btn.f3{bottom:24px;right:48px;background:var(--green);animation-delay:-2.1s}
.fish-btn.caught{animation:none;transform:scale(1.22);background:#FFFDF5;border-color:var(--red);color:var(--red);font-weight:700;z-index:3}
.fish-btn.dim{opacity:.48}

