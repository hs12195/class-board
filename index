  if (canDraw(seat)) openLotto(seat);
});
$('#lottoClose').addEventListener('click', closeLotto);

$('#lottoGame').addEventListener('click', async ev=>{
  if (S.lottoBusy || !S.lottoSeat || !S.board) return;
  const seat = S.lottoSeat;

  /* 0：掀牌 */
  const cardBtn = ev.target.closest('[data-lcard]');
  if (cardBtn) {
    S.lottoBusy = true;
    const pickedIdx = +cardBtn.dataset.lcard;
    const allCards = [...document.querySelectorAll('.lcard')];
    allCards.forEach(b => b.disabled = true);
    cardBtn.classList.add('picked');
    $('#lottoMsg').textContent = '掀開卡片中…';
    try {
      const [res] = await Promise.all([gs('drawLottery', S.board.date, seat), new Promise(r => setTimeout(r, 550))]);
      if (res && (res.ok || res.already)) {
        const others = [1, 2, 3].filter(n => n !== res.points);
        let oi = 0;
        allCards.forEach((b, idx) => {
          if (idx === pickedIdx) b.innerHTML = '<div class="cpts">+'+res.points+'</div><span>恭喜獲得</span>';
          else { b.classList.add('dim'); b.innerHTML = '<div style="font-size:24px;font-weight:700">+'+others[oi++]+'</div><span>未選中</span>'; }
        });
        finishLottoState(seat, res);
      }
    } catch(e) { $('#lottoMsg').textContent = errMsg(e); allCards.forEach(b => b.disabled = false); }
    S.lottoBusy = false;
    return;
  }

  /* 1：拉霸 */
  if (ev.target.closest('#slotPull')) {
    S.lottoBusy = true;
    const pullBtn = $('#slotPull'); pullBtn.disabled = true;
    $('#lottoMsg').textContent = '拉霸轉動中…';
    const reels = [$('#reel0'), $('#reel1'), $('#reel2')];
    const syms = ['⭐','🌙','☁️','⛵','🐦','+1','+2','+3'];
    let tick = 0;
    const iv = setInterval(()=>{
      tick++;
      reels.forEach((r, idx) => { if (!r.dataset.done) r.textContent = syms[(tick + idx * 3) % syms.length]; });
    }, 85);
    try {
      const res = await gs('drawLottery', S.board.date, seat);
      await new Promise(r => setTimeout(r, 600));
      if (res && (res.ok || res.already)) {
        for (let k = 0; k < 3; k++) {
          reels[k].dataset.done = '1';
          reels[k].innerHTML = '<span style="color:var(--red)">+'+res.points+'</span>';
          if (k < 2) await new Promise(r => setTimeout(r, 250));
        }
        clearInterval(iv);
        finishLottoState(seat, res);
      } else clearInterval(iv);
    } catch(e) { clearInterval(iv); $('#lottoMsg').textContent = errMsg(e); pullBtn.disabled = false; }
    S.lottoBusy = false;
    return;
  }

  /* 2：滾珠珠 */
  if (ev.target.closest('#wheelSpin')) {
    S.lottoBusy = true;
    const spinBtn = $('#wheelSpin'); spinBtn.disabled = true;
    const drum = $('#wheelDrum'); drum.classList.add('spinning');
    $('#lottoMsg').textContent = '轉盤旋轉中，珠珠即將滾出…';
    try {
      const [res] = await Promise.all([gs('drawLottery', S.board.date, seat), new Promise(r => setTimeout(r, 1050))]);
      drum.classList.remove('spinning');
      if (res && (res.ok || res.already)) {
        $('#wheelChute').innerHTML = '<div class="gacha-ball">+'+res.points+'</div>';
        finishLottoState(seat, res);
      }
    } catch(e) { drum.classList.remove('spinning'); $('#lottoMsg').textContent = errMsg(e); spinBtn.disabled = false; }
    S.lottoBusy = false;
    return;
  }

  /* 3：抽繩結 */
  const ropeBtn = ev.target.closest('[data-rope]');
  if (ropeBtn) {
    S.lottoBusy = true;
    const pickedIdx = +ropeBtn.dataset.rope;
    const allRopes = [...document.querySelectorAll('.rope-btn')];
    allRopes.forEach(b => b.disabled = true);
    ropeBtn.classList.add('pulled');
    $('#lottoMsg').textContent = '用力拉出繩結中…';
    try {
      const [res] = await Promise.all([gs('drawLottery', S.board.date, seat), new Promise(r => setTimeout(r, 600))]);
      if (res && (res.ok || res.already)) {
        const others = [1, 2, 3].filter(n => n !== res.points);
        let oi = 0;
        allRopes.forEach((b, idx) => {
          const knot = b.querySelector('.rope-knot');
          if (idx === pickedIdx) knot.textContent = '+' + res.points + '分';
          else { b.classList.add('dim'); knot.textContent = '+' + others[oi++]; }
        });
        finishLottoState(seat, res);
      }
    } catch(e) { $('#lottoMsg').textContent = errMsg(e); allRopes.forEach(b => { b.disabled = false; b.classList.remove('pulled'); }); }
    S.lottoBusy = false;
    return;
  }

  /* 5：套圈圈 */
  if (ev.target.closest('#ringThrow')) {
    S.lottoBusy = true;
    const throwBtn = $('#ringThrow'); throwBtn.disabled = true;
    $('#ringPosts').classList.add('paused');
    $('#lottoMsg').textContent = '圈圈飛出去啦…';
    try {
      const [res] = await Promise.all([gs('drawLottery', S.board.date, seat), new Promise(r => setTimeout(r, 550))]);
      if (res && (res.ok || res.already)) {
        const winPost = Math.floor(Math.random() * 3);
        const others = [1, 2, 3].filter(n => n !== res.points);
        let oi = 0;
        [0,1,2].forEach(i => {
          $('#rcap' + i).textContent = '+' + (i === winPost ? res.points : others[oi++]) + '分';
        });
        const hoop = $('#ringHoop');
        hoop.classList.add('landed');
        $('#rpost' + winPost).appendChild(hoop);
        $('#rcap' + winPost).style.background = 'var(--coral)';
        finishLottoState(seat, res);
      }
    } catch(e) { $('#lottoMsg').textContent = errMsg(e); throwBtn.disabled = false; }
    S.lottoBusy = false;
    return;
  }

  /* 6：投籃 */
  if (ev.target.closest('#shootBall')) {
    S.lottoBusy = true;
    const shootBtn = $('#shootBall'); shootBtn.disabled = true;
    $('#bball').classList.add('shoot');
    $('#lottoMsg').textContent = '漂亮拋物線飛向籃框…';
    try {
      const [res] = await Promise.all([gs('drawLottery', S.board.date, seat), new Promise(r => setTimeout(r, 750))]);
      if (res && (res.ok || res.already)) {
        const sc = $('#hoopScore');
        sc.textContent = '空心入網 +' + res.points + ' 分！';
        sc.style.display = 'block';
        finishLottoState(seat, res);
      }
    } catch(e) { $('#lottoMsg').textContent = errMsg(e); shootBtn.disabled = false; }
    S.lottoBusy = false;
    return;
  }

  /* 7：射擊 */
  const targetBtn = ev.target.closest('[data-target]');
  if (targetBtn) {
    S.lottoBusy = true;
    const pickedIdx = +targetBtn.dataset.target;
    const allTargets = [...document.querySelectorAll('.target-btn')];
    allTargets.forEach(b => b.disabled = true);
    $('#lottoMsg').textContent = '砰！子彈飛向標靶…';
    try {
      const [res] = await Promise.all([gs('drawLottery', S.board.date, seat), new Promise(r => setTimeout(r, 450))]);
      if (res && (res.ok || res.already)) {
        const others = [1, 2, 3].filter(n => n !== res.points);
        let oi = 0;
        allTargets.forEach((b, idx) => {
          if (idx === pickedIdx) { b.classList.add('hit'); b.textContent = '+' + res.points + '分'; }
          else { b.classList.add('dim'); b.textContent = '+' + others[oi++]; }
        });
        finishLottoState(seat, res);
      }
    } catch(e) { $('#lottoMsg').textContent = errMsg(e); allTargets.forEach(b => b.disabled = false); }
    S.lottoBusy = false;
    return;
  }

  /* 8：摘蘋果 */
  const appleBtn = ev.target.closest('[data-apple]');
  if (appleBtn) {
    S.lottoBusy = true;
    const pickedIdx = +appleBtn.dataset.apple;
    const allApples = [...document.querySelectorAll('.apple-btn')];
    allApples.forEach(b => b.disabled = true);
    appleBtn.classList.add('picked');
    $('#lottoMsg').textContent = '摘下紅蘋果囉…';
    try {
      const [res] = await Promise.all([gs('drawLottery', S.board.date, seat), new Promise(r => setTimeout(r, 650))]);
      if (res && (res.ok || res.already)) {
        allApples.forEach((b, idx) => {
          if (idx === pickedIdx) b.textContent = '+' + res.points + '分';
          else b.classList.add('dim');
        });
        finishLottoState(seat, res);
      }
    } catch(e) { $('#lottoMsg').textContent = errMsg(e); allApples.forEach(b => { b.disabled = false; b.classList.remove('picked'); }); }
    S.lottoBusy = false;
    return;
  }

  /* 9：撈魚 */
  const fishBtn = ev.target.closest('[data-fish]');
  if (fishBtn) {
    S.lottoBusy = true;
    const pickedIdx = +fishBtn.dataset.fish;
    const allFish = [...document.querySelectorAll('.fish-btn')];
    allFish.forEach(b => b.disabled = true);
    $('#lottoMsg').textContent = '網子下水撈魚中…';
    try {
      const [res] = await Promise.all([gs('drawLottery', S.board.date, seat), new Promise(r => setTimeout(r, 500))]);
      if (res && (res.ok || res.already)) {
        allFish.forEach((b, idx) => {
          if (idx === pickedIdx) { b.classList.add('caught'); b.textContent = '🥅 +' + res.points + '分'; }
          else b.classList.add('dim');
        });
        finishLottoState(seat, res);
      }
    } catch(e) { $('#lottoMsg').textContent = errMsg(e); allFish.forEach(b => b.disabled = false); }
    S.lottoBusy = false;
  }
});

