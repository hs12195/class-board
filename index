function closeLotto(){
  if (S.lottoBusy) return;
  $('#lottoOv').classList.remove('show');
  S.lottoSeat = null;
}

function finishLottoState(seat, res){
  if (!S.board.lotteryToday) S.board.lotteryToday = {};
  if (!S.board.lotteryUsedCount) S.board.lotteryUsedCount = {};
  if (!S.board.scoreTotal) S.board.scoreTotal = {};
  S.board.lotteryToday[seat] = res.todayTotal != null ? res.todayTotal : ((S.board.lotteryToday[seat] || 0) + res.points);
  S.board.lotteryUsedCount[seat] = res.usedCount != null ? res.usedCount : ((S.board.lotteryUsedCount[seat] || 0) + 1);
  S.board.scoreTotal[seat] = res.total;
  S.lastJson = '';
  renderLeft();
  $('#lottoMsg').innerHTML = (res.already ? '今天的抽獎機會已經用完囉！' : '🎉 恭喜獲得 <b>+'+res.points+' 分</b>！') +
    '<br>目前總積分：<b>'+res.total+' 分</b>';
  $('#lottoClose').textContent = '太棒了！';
}

$('#tblWrap').addEventListener('click', ev=>{
