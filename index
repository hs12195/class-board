<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="教室聯絡簿">
<title>教室聯絡簿</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Huninn&display=swap" rel="stylesheet">
<script>
/* =====================================================================
 * 【外掛擴充模組設定】
 * ===================================================================== */
const PLUGIN_URL = 'https://raw.githubusercontent.com/hs12195/class-board-plugins/main/lotto-plugins.js';
window.LOTTO_PLUGINS = [];
if (PLUGIN_URL) {
  fetch(PLUGIN_URL)
    .then(res => {
      if (!res.ok) throw new Error('HTTP ' + res.status);
      return res.text();
    })
    .then(code => {
      (new Function(code))();
      console.log('✅ 外部遊戲載入成功，共', window.LOTTO_PLUGINS.length, '款');
    })
    .catch(err => console.log('無外部擴充模組，使用內建模式', err));
}
</script>
<style>
:root{
  --paper:#FFFCF6; --card:#FFFEFA; --ink:#3E3A39;
  --coral:#F2A497; --yellow:#F6D27A; --sky:#A8D3E6; --green:#B9DAA5;
  --red:#D9453D; --navy:#14456A; --tickgreen:#6DB04F;
  --bd:3px solid var(--ink); --r:20px; --shadow:4px 4px 0 var(--ink);
  --font:'Huninn','jf-openhuninn','Noto Sans TC','PingFang TC','Microsoft JhengHei',sans-serif;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;height:100%;background:var(--paper);color:var(--ink);font-family:var(--font)}
body{overflow:hidden}
button{font:inherit;color:inherit;cursor:pointer;touch-action:manipulation}
h1,h2,h3,p{margin:0}
svg{display:block}

/* ---------- 動畫 ---------- */
@keyframes float{0%,100%{transform:translateY(0) rotate(var(--rot,0deg))}50%{transform:translateY(-7px) rotate(calc(var(--rot,0deg) + 5deg))}}
@keyframes pop{0%{transform:scale(.55)}55%{transform:scale(1.2)}100%{transform:scale(1)}}
@keyframes pulse{0%{opacity:1}50%{opacity:.35}100%{opacity:1}}
@keyframes twinkle{0%,100%{transform:scale(1) rotate(-6deg)}50%{transform:scale(1.18) rotate(8deg)}}
@keyframes spinDrum{0%{transform:rotate(0deg)}100%{transform:rotate(1080deg)}}
@keyframes ballDrop{0%{transform:translateY(-35px) scale(.4);opacity:0}65%{transform:translateY(4px) scale(1.15);opacity:1}100%{transform:translateY(0) scale(1);opacity:1}}
@keyframes ropePull{0%{transform:translateY(0)}45%{transform:translateY(22px)}100%{transform:translateY(8px)}}
@keyframes swayPosts{0%,100%{transform:translateX(-14px)}50%{transform:translateX(14px)}}
@keyframes shootBasket{0%{transform:translate(0,0) scale(1)}50%{transform:translate(0,-115px) scale(.82)}85%{transform:translate(0,-88px) scale(.75)}100%{transform:translate(0,-65px) scale(.75);opacity:0}}
@keyframes appleDrop{0%{transform:translateY(0) rotate(0deg)}75%{transform:translateY(105px) rotate(25deg)}100%{transform:translateY(96px) rotate(12deg)}}
@keyframes swimFish{0%,100%{transform:translate(0,0) scaleX(1)}50%{transform:translate(14px,-6px) scaleX(1)}}
.deco{position:absolute;pointer-events:none;animation:float 5s ease-in-out infinite}
.pop .badge,.pop .tick,.pop .xmark{animation:pop .34s cubic-bezier(.3,1.6,.5,1)}
.dot.busy{animation:pulse .8s ease-in-out infinite}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation:none!important;transition:none!important}
}

/* ---------- 前台（教室大螢幕） ---------- */
#front{height:100vh;height:100dvh;display:grid;grid-template-rows:minmax(0,1fr) auto;gap:.8vh;padding:1.5vh 1.3vw .6vh}
.main{display:grid;grid-template-columns:55fr 45fr;gap:1.3vw;min-height:0}
.panel{position:relative;display:flex;flex-direction:column;min-height:0;overflow:hidden;background:var(--card);border:var(--bd);border-radius:var(--r);box-shadow:var(--shadow)}
.phead{position:relative;flex:none;display:flex;align-items:center;gap:.9vw;padding:.9vh 1.2vw;border-bottom:var(--bd);min-height:9vh}
.left .phead{background:var(--sky)}
.right .phead{background:var(--yellow);justify-content:space-between}
.hicon{width:6.4vh;height:6.4vh;flex:none}
.ttl h1{font-size:clamp(20px,3.5vh,44px);line-height:1.15}
.ttl p{font-size:clamp(11px,1.75vh,22px);margin-top:.4vh;line-height:1.3}
.phead .deco{right:1vw;top:50%;margin-top:-3.6vh;width:7.2vh;height:7.2vh;--rot:8deg}
.phead .pencil-secret{pointer-events:auto;cursor:pointer;border-radius:14px;transition:transform .12s}
.phead .pencil-secret:active{transform:scale(.88)}

/* 作業表格 */
.tblwrap{flex:1 1 0;min-height:0;display:flex;flex-direction:column}
.tbl{flex:1;min-height:0;display:grid;--b:clamp(38px,5.2vh,54px);
  grid-template-columns:minmax(150px,1.35fr) repeat(var(--cols),minmax(120px,1fr));
  grid-template-rows:auto repeat(var(--rows),minmax(68px,1fr));
  overflow:auto;-webkit-overflow-scrolling:touch;scrollbar-width:thin}
.th{position:sticky;top:0;z-index:3;display:flex;align-items:center;justify-content:center;text-align:center;padding:1vh .6vw;background:#FFF3D1;border-bottom:var(--bd);border-left:2px solid rgba(62,58,57,.35);font-size:clamp(16px,2.7vh,32px);line-height:1.25;font-weight:700;word-break:break-word}
.th.corner{left:0;z-index:4;justify-content:flex-start;padding:1vh .8vw;border-left:0;background:var(--green);font-size:clamp(15px,2.4vh,28px)}
.dense .th{font-size:clamp(14px,2.2vh,26px)}
.tmp{font-style:normal;margin-left:.3em;padding:0 .35em;border:2px solid var(--ink);border-radius:8px;background:var(--coral);font-size:.7em}
.nm{position:sticky;left:0;z-index:2;display:flex;align-items:center;gap:.5vw;padding:0 .8vw;border-bottom:2px solid rgba(62,58,57,.22);font-size:clamp(16px,2.9vh,34px);white-space:nowrap;overflow:hidden;border-top:0;border-left:0;border-right:0;background:var(--card);text-align:left;width:100%}
.nm.odd{background:#FFF7E6}
.nm .no{display:grid;place-items:center;flex:none;min-width:1.55em;height:1.55em;padding:0 .2em;border:2px solid var(--ink);border-radius:50%;background:var(--paper);font-size:.82em;line-height:1}
.nm .sname{overflow:hidden;text-overflow:ellipsis;flex:1;min-width:0}
.nm-btn{cursor:pointer}
.nm-btn:hover{background:#FFF3D1}
.nm-btn:active{transform:scale(.97)}
.star-ic{width:1.15em;height:1.15em;flex:none;animation:twinkle 1.6s ease-in-out infinite;filter:drop-shadow(1px 1px 0 rgba(62,58,57,.4))}
.star-done{flex:none;display:inline-flex;align-items:center;gap:.15em;padding:.08em .42em;border:2px solid var(--ink);border-radius:999px;background:var(--yellow);font-size:.58em;font-weight:700;line-height:1.2}
.cell{position:relative;display:flex;align-items:center;justify-content:center;min-width:0;min-height:0;padding:0;border:0;border-bottom:2px solid rgba(62,58,57,.22);border-left:2px solid rgba(62,58,57,.2);background:transparent}
.odd{background:#FFF7E6}
.bw{position:relative;display:inline-flex;width:var(--b);height:var(--b)}
.badge{display:grid;place-items:center;width:100%;height:100%;border:3px solid var(--ink);border-radius:28%;font-size:calc(var(--b)*.6);line-height:1;font-weight:700;transition:transform .12s}
.badge.red{background:var(--red);color:#fff}
.badge.blue{background:var(--sky);color:var(--navy)}
.tick{width:calc(var(--b)*1.1);height:calc(var(--b)*1.1);transition:transform .12s}
.xmark{position:absolute;left:-14%;top:-14%;width:128%;height:128%;pointer-events:none}
.none{opacity:.22;font-size:calc(var(--b)*.55)}
.empty{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1.2vh;text-align:center;padding:2vh;font-size:clamp(16px,3vh,36px)}
.empty svg{width:16vh;height:16vh;animation:float 5s ease-in-out infinite}
.empty small{font-size:.6em;opacity:.75}

.legend{flex:none;display:flex;flex-wrap:wrap;align-items:center;gap:.5vh 1.1vw;padding:.7vh 1vw;border-top:var(--bd);background:#FFF7E6;font-size:clamp(10px,1.6vh,19px)}
.legend .li{display:inline-flex;align-items:center;gap:.4em;--b:2.4vh}
.legend .li .badge{border-width:2px}
.carry{flex:none;display:flex;gap:.8vw;align-items:flex-start;max-height:17vh;padding:.8vh 1vw;border-top:var(--bd);background:#FDEBE6}
.ctag{flex:none;padding:.5vh 1vw;border:var(--bd);border-radius:14px;background:var(--coral);font-size:clamp(12px,2vh,24px);font-weight:700;line-height:1.2;box-shadow:3px 3px 0 var(--ink)}
.cbody{flex:1;min-width:0;max-height:15vh;overflow:auto;display:flex;flex-wrap:wrap;gap:.6vh .8vw;align-content:flex-start;--b:3.4vh}
.cg{display:inline-flex;align-items:center;flex-wrap:wrap;gap:.35vw;padding:.4vh .7vw;border:2px solid var(--ink);border-radius:14px;background:var(--card);font-size:clamp(11px,1.9vh,22px)}
.cg .cd{font-weight:700}
.cg .badge{border-width:2px}
.cok{align-self:center;font-size:clamp(12px,2vh,24px)}

/* 右：聯絡簿 + 今日黑板便條 */
.rhead{display:flex;align-items:center;justify-content:space-between;width:100%;gap:.6vw}
.navbtn{flex:none;width:6.2vh;height:6.2vh;display:grid;place-items:center;border:var(--bd);border-radius:50%;background:var(--card);box-shadow:3px 3px 0 var(--ink);padding:0}
.navbtn:active{transform:translate(2px,2px);box-shadow:1px 1px 0 var(--ink)}
.navbtn svg{width:55%;height:55%}
.dtbox{flex:1;text-align:center;min-width:0}
.dt{font-size:clamp(17px,3.1vh,40px);line-height:1.25;font-weight:700}
.dtsub{margin-top:.3vh;font-size:clamp(11px,1.7vh,20px);min-height:1.2em}
.chip{display:inline-block;padding:0 .7em;border:2px solid var(--ink);border-radius:999px;background:var(--coral);font-size:.9em}
.chipbtn{font:inherit;cursor:pointer;background:var(--sky)}
.notice-bar{flex:none;display:flex;align-items:center;gap:.6vw;padding:.8vh 1.1vw;border-bottom:var(--bd);background:#FDEBE6;font-size:clamp(14px,2.2vh,25px);font-weight:700;line-height:1.35}
.notice-bar .ntag{flex:none;padding:.1em .55em;border:2px solid var(--ink);border-radius:10px;background:var(--coral);font-size:.82em}
.rbody{position:relative;flex:1;min-height:0;display:flex;padding:1.2vh 1.4vw}
.vbox{flex:1;align-self:stretch;min-width:0;overflow:hidden;writing-mode:vertical-rl;text-orientation:mixed;font-size:var(--vfs,4vh);line-height:1.55}
.vbox ol{list-style:none;margin:0;padding:0;height:100%}
.vbox li{margin:0;padding-left:.45em;margin-left:.45em;border-left:2px dashed rgba(62,58,57,.4)}
.vbox li:last-child{border-left:0}
.vbox .no{text-combine-upright:all;-webkit-text-combine:horizontal;font-weight:700;color:var(--coral);-webkit-text-stroke:0;margin-block-end:.15em;display:inline-block}
.vbox .tcy{text-combine-upright:all;-webkit-text-combine:horizontal;white-space:nowrap}
.vbox li.hw .t{background:#FBE7B0;border-radius:6px}
.rfoot{flex:none;position:relative;display:flex;align-items:center;gap:1vw;min-height:6vh;padding:.5vh 1.2vw;border-top:var(--bd);background:#FFF7E6;font-size:clamp(10px,1.6vh,19px)}
.rfoot .sw{display:inline-block;width:1.4em;height:1em;border:2px solid var(--ink);border-radius:5px;background:#FBE7B0;vertical-align:-.15em;margin-right:.4em}
.rfoot .sky-icons{margin-left:auto;display:flex;align-items:center;gap:.6vw}
.rfoot .sky-icons svg{width:5vh;height:5vh;animation:float 4.5s ease-in-out infinite}
.rfoot .sky-icons svg:nth-child(2){animation-delay:-1.6s}
.rfoot .sky-icons svg:nth-child(3){animation-delay:-3s}

/* 底部列 */
.fbar{display:flex;align-items:center;justify-content:space-between;gap:1vw;font-size:clamp(10px,1.6vh,18px);min-height:3.4vh}
.sync{display:inline-flex;align-items:center;gap:.5em;opacity:.75}
.dot{width:.8em;height:.8em;border-radius:50%;background:var(--tickgreen);border:2px solid var(--ink)}
.dot.off{background:var(--red)}
.fbar-acts{display:flex;align-items:center;gap:.6vw;flex-wrap:wrap}
.tbtn{opacity:.85;padding:.4vh 1vw;border:2px solid var(--ink);border-radius:999px;background:var(--card);font-size:inherit;box-shadow:2px 2px 0 var(--ink)}
.tbtn.rank{background:var(--yellow);font-weight:700}
.tbtn:hover,.tbtn:focus-visible{opacity:1}
.tbtn:active{transform:translate(1px,1px);box-shadow:1px 1px 0 var(--ink)}

/* 窄螢幕／直式（手機看前台） */
@media (max-aspect-ratio:1/1),(max-width:820px){
  body{overflow:auto}
  #front{height:auto;min-height:100dvh;display:block;padding:10px}
  .main{display:flex;flex-direction:column;gap:14px}
  .panel{overflow:visible}
  .phead{min-height:64px;padding:8px 12px;gap:10px}
  .hicon{width:44px;height:44px}
  .ttl h1{font-size:22px}.ttl p{font-size:12px}
  .phead .deco{width:50px;height:50px;margin-top:-25px}
  .tbl{--b:40px;grid-template-columns:minmax(125px,1.3fr) repeat(var(--cols),minmax(105px,1fr));grid-template-rows:auto repeat(var(--rows),64px);max-height:58vh;flex:none}
  .th{font-size:15px}.th.corner{font-size:14px}.nm{font-size:16px;padding:0 8px;gap:6px}
  .legend{font-size:12px;gap:6px 12px}.legend .li{--b:22px}
  .carry{max-height:none;flex-direction:column;padding:10px 12px}.cbody{max-height:none;--b:28px}
  .ctag{font-size:15px}.cg{font-size:13px}
  .navbtn{width:44px;height:44px}.dt{font-size:20px}.dtsub{font-size:12px}
  .notice-bar{font-size:14px;padding:8px 12px}
  .rbody{flex:none;height:62vh;padding:10px 12px}
  .rfoot{font-size:12px}.rfoot .sky-icons svg{width:34px;height:34px}
  .fbar{font-size:12px;padding:10px 4px;flex-wrap:wrap}.tbtn{padding:6px 12px}
}

/* ---------- 彈窗／提示 ---------- */
.overlay{position:fixed;inset:0;z-index:50;display:none;align-items:center;justify-content:center;padding:16px;background:rgba(62,58,57,.38)}
.overlay.show{display:flex}
.modal{width:min(490px,100%);max-height:90vh;overflow:auto;padding:22px;background:var(--card);border:var(--bd);border-radius:var(--r);box-shadow:var(--shadow)}
.modal h2{font-size:26px;margin-bottom:14px;display:flex;align-items:center;gap:10px}
.in{width:100%;min-height:52px;padding:10px 14px;border:var(--bd);border-radius:14px;background:#fff;font:inherit;font-size:19px;color:var(--ink)}
.in:focus{outline:3px solid var(--sky);outline-offset:1px}
.row2{display:flex;gap:10px;margin-top:14px}
.btn{min-height:56px;padding:10px 18px;border:var(--bd);border-radius:16px;background:var(--yellow);box-shadow:3px 3px 0 var(--ink);font-size:20px;line-height:1.2}
.btn:active{transform:translate(2px,2px);box-shadow:1px 1px 0 var(--ink)}
.btn.sky{background:var(--sky)}.btn.green{background:var(--green)}.btn.coral{background:var(--coral)}.btn.plain{background:var(--card)}
.btn.sm{min-height:44px;padding:6px 12px;font-size:17px;border-radius:14px}
.btn[disabled]{opacity:.5}
.grow{flex:1}
#toast{position:fixed;left:50%;bottom:4vh;z-index:80;transform:translateX(-50%);padding:10px 20px;border:var(--bd);border-radius:999px;background:var(--yellow);box-shadow:var(--shadow);font-size:18px;opacity:0;pointer-events:none;transition:opacity .2s;max-width:92vw;text-align:center}
#toast.show{opacity:1}

/* ---------- 星星抽獎（10種內建 + 無限外掛） ---------- */
.lotto-box{text-align:center}
.lotto-box h2{justify-content:center;font-size:27px}
.lotto-who{font-size:20px;margin-bottom:12px;padding:5px 16px;display:inline-block;background:var(--sky);border:2px solid var(--ink);border-radius:999px}
.lotto-msg{font-size:19px;line-height:1.5;min-height:2.8em;margin-top:10px}

.cards-row{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:10px auto 14px;max-width:390px}
.lcard{aspect-ratio:3/4;border:var(--bd);border-radius:18px;background:linear-gradient(145deg,#FFF4CC,#F6D27A);box-shadow:4px 4px 0 var(--ink);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;padding:8px;transition:transform .15s,background .2s}
.lcard:hover:not(:disabled){transform:translateY(-5px)}
.lcard svg{width:54px;height:54px}
.lcard span{font-size:18px;font-weight:700}
.lcard.picked{background:#FFFDF5;border-color:var(--red);transform:scale(1.06)}
.lcard.dim{opacity:.55;background:#F3EFE6}
.lcard .cpts{font-size:34px;font-weight:700;color:var(--red);animation:pop .4s cubic-bezier(.3,1.6,.5,1)}

.slot-wrap{display:flex;align-items:center;justify-content:center;gap:12px;margin:10px auto 14px}
.slot-frame{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:12px;background:var(--coral);border:var(--bd);border-radius:20px;box-shadow:var(--shadow)}
.slot-reel{width:76px;height:88px;background:var(--card);border:var(--bd);border-radius:14px;display:grid;place-items:center;font-size:34px;font-weight:700;color:var(--navy)}
.slot-reel svg{width:46px;height:46px}
.slot-lever{display:flex;flex-direction:column;align-items:center;gap:4px;padding:10px 12px;background:var(--yellow);border:var(--bd);border-radius:18px;box-shadow:3px 3px 0 var(--ink);font-weight:700}
.slot-ball{width:30px;height:30px;border-radius:50%;background:var(--red);border:var(--bd)}

.wheel-wrap{position:relative;display:flex;flex-direction:column;align-items:center;margin:6px auto 12px}
.wheel-drum{width:136px;height:136px;border-radius:50%;border:var(--bd);background:radial-gradient(circle at 35% 30%,#FFFFFF,#A8D3E6);box-shadow:var(--shadow);position:relative;display:grid;place-items:center}
.wheel-drum.spinning{animation:spinDrum 1.05s cubic-bezier(.25,.85,.35,1)}
.wheel-drum .mini-b{position:absolute;width:28px;height:28px;border-radius:50%;border:2.5px solid var(--ink);font-size:13px;font-weight:700;display:grid;place-items:center}
.wheel-drum .b1{top:16px;left:34px;background:var(--yellow)}
.wheel-drum .b2{top:34px;right:20px;background:var(--coral)}
.wheel-drum .b3{bottom:22px;left:24px;background:var(--green)}
.wheel-drum .b4{bottom:24px;right:34px;background:#FFF}
.wheel-chute{margin-top:-10px;z-index:2;min-height:66px;display:grid;place-items:center}
.gacha-ball{width:64px;height:64px;border-radius:50%;border:var(--bd);background:linear-gradient(135deg,#F6D27A 50%,#F2A497 50%);box-shadow:3px 3px 0 var(--ink);display:grid;place-items:center;font-size:26px;font-weight:700;color:var(--ink);animation:ballDrop .5s cubic-bezier(.3,1.5,.5,1)}

.ropes-box{position:relative;max-width:360px;margin:8px auto 14px;padding-top:10px}
.ropes-bar{height:22px;background:var(--coral);border:var(--bd);border-radius:999px;box-shadow:3px 3px 0 var(--ink);position:relative;z-index:2}
.ropes-row{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;padding:0 12px}
.rope-btn{display:flex;flex-direction:column;align-items:center;background:transparent;border:0;padding:0}
.rope-line{width:10px;height:68px;border-left:3px solid var(--ink);border-right:3px solid var(--ink);background:repeating-linear-gradient(45deg,#F6D27A,#F6D27A 8px,#FFF 8px,#FFF 16px)}
.rope-btn[data-rope="1"] .rope-line{background:repeating-linear-gradient(45deg,#A8D3E6,#A8D3E6 8px,#FFF 8px,#FFF 16px)}
.rope-btn[data-rope="2"] .rope-line{background:repeating-linear-gradient(45deg,#B9DAA5,#B9DAA5 8px,#FFF 8px,#FFF 16px)}
.rope-knot{width:54px;height:54px;margin-top:-4px;border-radius:50%;border:var(--bd);background:var(--yellow);box-shadow:3px 3px 0 var(--ink);display:grid;place-items:center;font-size:18px;font-weight:700}
.rope-btn.pulled{animation:ropePull .55s ease-out forwards}
.rope-btn.pulled .rope-knot{background:#FFFDF5;border-color:var(--red);color:var(--red);font-size:24px;width:64px;height:64px}
.rope-btn.dim{opacity:.48}

.scratch-box{position:relative;width:270px;height:130px;margin:10px auto 14px;border:var(--bd);border-radius:20px;background:linear-gradient(135deg,#FFF4CC,#F6D27A);box-shadow:var(--shadow);overflow:hidden;user-select:none}
.scratch-under{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:38px;font-weight:700;color:var(--red)}
.scratch-under small{font-size:16px;color:var(--ink)}
#scratchCanvas{position:absolute;inset:0;width:100%;height:100%;touch-action:none;cursor:crosshair}

.ring-stage{position:relative;height:185px;max-width:360px;margin:8px auto 12px;background:#EBF6FC;border:var(--bd);border-radius:18px;overflow:hidden;display:flex;flex-direction:column;justify-content:space-between;padding:16px 12px}
.ring-posts{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;animation:swayPosts 2.2s ease-in-out infinite}
.ring-posts.paused{animation-play-state:paused}
.rpost{display:flex;flex-direction:column;align-items:center;position:relative}
.rpost-cap{padding:4px 10px;border:2.5px solid var(--ink);border-radius:12px;background:var(--yellow);font-weight:700;font-size:18px}
