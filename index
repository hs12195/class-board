.ring-hoop{width:68px;height:24px;border:5px solid var(--red);border-radius:50%;margin:0 auto;box-shadow:0 2px 0 var(--ink);transition:transform .45s cubic-bezier(.2,1.4,.4,1)}
.ring-hoop.landed{position:absolute;top:36px;left:50%;transform:translateX(-50%) scale(1.08);z-index:3}

.hoop-stage{position:relative;height:190px;max-width:340px;margin:8px auto 12px;background:#FFF7E6;border:var(--bd);border-radius:18px;overflow:hidden;display:flex;flex-direction:column;align-items:center;justify-content:space-between;padding:12px}
.backboard{width:130px;height:68px;background:#FFF;border:var(--bd);border-radius:10px;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;padding-bottom:6px;position:relative}
.backboard-sq{width:46px;height:30px;border:3px solid var(--red)}
.rim{width:56px;height:12px;background:var(--red);border:2.5px solid var(--ink);border-radius:999px;margin-top:-4px;z-index:2}
.net{width:44px;height:26px;border-left:3px dashed var(--ink);border-right:3px dashed var(--ink);border-bottom:3px dashed var(--ink);border-radius:0 0 12px 12px}
.bball{width:48px;height:48px;border-radius:50%;background:#F28C38;border:var(--bd);display:grid;place-items:center;font-size:22px;font-weight:700;box-shadow:2px 2px 0 var(--ink)}
.bball.shoot{animation:shootBasket .75s ease-in forwards}
.hoop-score{position:absolute;top:52px;font-size:32px;font-weight:700;color:var(--red);animation:pop .4s ease-out}

.shoot-stage{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;max-width:380px;margin:12px auto 14px}
.target-btn{aspect-ratio:1/1;border-radius:50%;border:var(--bd);background:radial-gradient(circle,var(--red) 0 24%,#FFF 24% 48%,var(--sky) 48% 72%,#FFF 72% 100%);box-shadow:3px 3px 0 var(--ink);display:grid;place-items:center;font-size:22px;font-weight:700;transition:transform .12s}
.target-btn:hover:not(:disabled){transform:scale(1.07)}
.target-btn.hit{background:#FFFDF5;border-color:var(--red);color:var(--red);font-size:30px;animation:pop .35s}
.target-btn.dim{opacity:.48}

.tree-stage{position:relative;height:200px;max-width:360px;margin:8px auto 12px;background:#EBF6FC;border:var(--bd);border-radius:18px;overflow:hidden}
.tree-crown{position:absolute;top:8px;left:50%;transform:translateX(-50%);width:270px;height:125px;background:var(--green);border:var(--bd);border-radius:60px}
.tree-trunk{position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:48px;height:75px;background:#C89D7C;border:var(--bd);border-bottom:0}
.apple-btn{position:absolute;width:46px;height:46px;border-radius:50%;background:var(--red);border:2.5px solid var(--ink);color:#FFF;font-weight:700;font-size:15px;display:grid;place-items:center;box-shadow:2px 2px 0 var(--ink);z-index:2}
.apple-btn.a0{top:26px;left:76px}
.apple-btn.a1{top:22px;right:82px}
.apple-btn.a2{top:72px;left:110px}
.apple-btn.a3{top:68px;right:108px}
.apple-btn.picked{animation:appleDrop .65s ease-in forwards;background:var(--yellow);color:var(--red);font-size:20px;width:54px;height:54px}
.apple-btn.dim{opacity:.5}

.pond-stage{position:relative;height:185px;max-width:370px;margin:8px auto 12px;background:linear-gradient(180deg,#D8F1FC,#A8D3E6);border:var(--bd);border-radius:22px;overflow:hidden}
.fish-btn{position:absolute;padding:6px 12px;border-radius:999px;border:2.5px solid var(--ink);background:var(--coral);font-size:22px;box-shadow:2px 2px 0 var(--ink);animation:swimFish 2.4s ease-in-out infinite}
