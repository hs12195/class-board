<script>
const $ = (s, r) => (r || document).querySelector(s);
const esc = s => String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
const WD = ['日','一','二','三','四','五','六'];
const LABEL = { unsubmitted:'未交', done:'已完成', correction:'待訂正', corrected:'訂正完成' };
const NEXT  = { '':'done', done:'unsubmitted', unsubmitted:'correction', correction:'corrected', corrected:'' };
const POLL_MS = 60000;

function parseYmd(s){ const p = s.split('-').map(Number); return new Date(Date.UTC(p[0], p[1]-1, p[2])); }
function fmtYmd(d){ return d.getUTCFullYear()+'-'+String(d.getUTCMonth()+1).padStart(2,'0')+'-'+String(d.getUTCDate()).padStart(2,'0'); }
function addDays(s,n){ const d = parseYmd(s); d.setUTCDate(d.getUTCDate()+n); return fmtYmd(d); }
function dow(s){ return parseYmd(s).getUTCDay(); }
function stepSchool(s,dir){ let d = addDays(s,dir); while(dow(d)===0 || dow(d)===6) d = addDays(d,dir); return d; }
function md(s){ const p = s.split('-'); return (+p[1])+'/'+(+p[2]); }
function nowTime(){ return new Date().toLocaleTimeString('zh-TW',{hour12:false}); }

const S = {
  board:null, viewDate:null, lastJson:'',
  adminOpen:false, tab:'week',
  week:null, draft:{}, dirty:{},
  sel:null, mode:'done', tempOpen:false, delArm:false, resetArm:false,
  lottoSeat:null, lottoBusy:false, lottoMode:0,
  ptSeats:new Set(), ptReason:'發表踴躍',
  pending:0, writeSeq:0, lastWrite:0, queue:Promise.resolve(), fetching:false, online:true,
  batchBuffer:{}, batchTimer:null
};

// 【重要設定】請將下方引號內的網址，替換為你 Google Apps Script 部署後的「網頁應用程式網址」(結尾為 /exec)
const GAS_API_URL = 'https://script.google.com/macros/s/AKfycbyHND1Zr2iAY-5Iy4_unmNZCxghphRqsOXED_YEDGhgojDiU26K17tF7SiLYCb25vp_/exec';

async function gs(fn){
  const args = Array.prototype.slice.call(arguments, 1);
  // 若仍在 GAS iframe 內執行，優先使用原生高速通道
  if (typeof google !== 'undefined' && google.script && google.script.run) {
    return new Promise((resolve, reject) => {
      google.script.run
        .withSuccessHandler(res => resolve(res))
        .withFailureHandler(err => reject(err))
        [fn].apply(null, args);
    });
  }
  // 獨立託管於 GitHub Pages 時，改用 fetch() 跨網域呼叫 GAS API
  if (!GAS_API_URL || GAS_API_URL.includes('請在這裡貼上')) {
    throw new Error('尚未設定 GAS_API_URL！請開啟 index.html 第 333 行貼上你的 GAS 網址');
  }
  const res = await fetch(GAS_API_URL, {
    method: 'POST',
    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
    body: JSON.stringify({ fn: fn, args: args }),
    redirect: 'follow'
  });
  if (!res.ok) throw new Error('伺服器連線失敗 (HTTP ' + res.status + ')');
  const data = await res.json();
  if (data && data.error) throw new Error(data.error);
  return data.result;
}

function errMsg(e){ return (e && e.message) ? String(e.message).replace(/^Error:\s*/,'') : String(e||'發生錯誤'); }
function handleErr(e){ toast(errMsg(e)); }
let toastT;
function toast(msg){
  const t = $('#toast'); t.textContent = msg; t.classList.add('show');
  clearTimeout(toastT); toastT = setTimeout(()=>t.classList.remove('show'), 2800);
}
function enqueue(fn, args){
  S.pending++; S.writeSeq++; S.lastWrite = Date.now();
  S.queue = S.queue.then(()=>gs.apply(null,[fn].concat(args)))
    .then(()=>{ S.pending--; S.lastWrite = Date.now(); })
    .catch(e=>{ S.pending--; handleErr(e); fetchBoard(true); });
  return S.queue;
}

/* ---------- 連點座號自動合併批次送出（350ms 防抖） ---------- */
function flushStatusBuffer(){
  clearTimeout(S.batchTimer);
  S.batchTimer = null;
  const keys = Object.keys(S.batchBuffer);
  if (!keys.length) return Promise.resolve();
  const payloadList = keys.map(k => S.batchBuffer[k]);
  S.batchBuffer = {};
  return enqueue('setStatusBatch', [payloadList]);
}

function queueStatusBatch(payloadList){
  S.writeSeq++;
  S.lastWrite = Date.now();
  payloadList.forEach(p => {
    const k = p.due + '|' + p.source + '|' + p.name + '|' + p.seat;
    S.batchBuffer[k] = p;
  });
  clearTimeout(S.batchTimer);
  S.batchTimer = setTimeout(() => { flushStatusBuffer(); }, 350);
}

function icon(status, seat){
  if (status === 'done')
    return '<svg class="tick" viewBox="0 0 60 60" aria-hidden="true"><path d="M9 32 L25 48 L52 13" fill="none" stroke="#3E3A39" stroke-width="15" stroke-linecap="round" stroke-linejoin="round"/><path d="M9 32 L25 48 L52 13" fill="none" stroke="#6DB04F" stroke-width="8.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  if (status === 'unsubmitted') return '<span class="bw"><span class="badge red">'+seat+'</span></span>';
  if (status === 'correction')  return '<span class="bw"><span class="badge blue">'+seat+'</span></span>';
  if (status === 'corrected')
    return '<span class="bw"><span class="badge blue">'+seat+'</span><svg class="xmark" viewBox="0 0 100 100" aria-hidden="true"><path d="M14 14 L86 86 M86 14 L14 86" stroke="#3E3A39" stroke-width="17" stroke-linecap="round"/><path d="M14 14 L86 86 M86 14 L14 86" stroke="#D9453D" stroke-width="9" stroke-linecap="round"/></svg></span>';
  return '<span class="none">—</span>';
}
const skey = (it, seat) => it.source+'|'+it.name+'|'+seat;

function canDraw(seat){
  const b = S.board;
  if (!b || b.date !== b.today) return false;
  const regularItems = b.items.filter(it => !it.temp);
  const hwCompleted = b.weekday && regularItems.length > 0 &&
    regularItems.every(it => {
      const t = b.status[skey(it, seat)];
      return t === 'done' || t === 'corrected';
    }) &&
    !b.carry.some(g => g.entries.some(e => e.seat === seat));

  const extra = (b.lotteryExtraQuota && Number(b.lotteryExtraQuota[seat])) || 0;
  const used = (b.lotteryUsedCount && Number(b.lotteryUsedCount[seat])) || 0;
  const totalAllowed = (hwCompleted ? 1 : 0) + extra;
  return totalAllowed > used;
}

