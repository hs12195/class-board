 * 星星抽獎（內建 10 種 + 外部 plugins.js 動態擴充）
 * ===================================================== */
function initScratchPad(seat){
  const canvas = $('#scratchCanvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const W = canvas.width = 270, H = canvas.height = 130;
  ctx.fillStyle = '#C5C9CE';
  ctx.fillRect(0, 0, W, H);
  ctx.fillStyle = '#A8AEB5';
  for (let x = -H; x < W + H; x += 22) {
    ctx.beginPath();
    ctx.moveTo(x, 0); ctx.lineTo(x + 10, 0);
    ctx.lineTo(x - H + 10, H); ctx.lineTo(x - H, H);
    ctx.closePath(); ctx.fill();
  }
  ctx.fillStyle = '#3E3A39';
  ctx.font = 'bold 20px sans-serif';
  ctx.textAlign = 'center';
  ctx.fillText('✨ 用手指刮開銀漆 ✨', W / 2, H / 2 + 7);

  let drawing = false, fetched = false, revealed = false;

  async function ensureScore(){
    if (fetched) return;
    fetched = true;
    S.lottoBusy = true;
    $('#lottoMsg').textContent = '刮開中，揭曉幸運分數…';
    try {
      const res = await gs('drawLottery', S.board.date, seat);
      if (res && (res.ok || res.already)) {
        $('#scratchPts').textContent = '+' + res.points + ' 分';
        canvas._lottoRes = res;
      }
    } catch(e) {
      $('#lottoMsg').textContent = errMsg(e);
    }
    S.lottoBusy = false;
  }

  function scratchAt(clientX, clientY){
    if (revealed) return;
    const rect = canvas.getBoundingClientRect();
    const x = (clientX - rect.left) * (W / rect.width);
    const y = (clientY - rect.top) * (H / rect.height);
    ctx.globalCompositeOperation = 'destination-out';
    ctx.beginPath();
    ctx.arc(x, y, 22, 0, Math.PI * 2);
    ctx.fill();
    ensureScore();
    checkPercent();
  }

  function checkPercent(){
    if (revealed || !canvas._lottoRes) return;
    const data = ctx.getImageData(0, 0, W, H).data;
    let clear = 0;
    for (let i = 3; i < data.length; i += 16) {
      if (data[i] === 0) clear++;
    }
    if (clear / (data.length / 16) > 0.42) {
      revealed = true;
      canvas.style.transition = 'opacity .35s';
      canvas.style.opacity = '0';
      finishLottoState(seat, canvas._lottoRes);
    }
  }

  canvas.addEventListener('pointerdown', e => { drawing = true; scratchAt(e.clientX, e.clientY); });
  canvas.addEventListener('pointermove', e => { if (drawing) scratchAt(e.clientX, e.clientY); });
  window.addEventListener('pointerup', () => { drawing = false; checkPercent(); }, { once: false });
}

