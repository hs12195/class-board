/* ---------- 分頁一：一週排程 + 黑板便條 ---------- */
async function loadWeek(anchor){
  const w = await gs('getWeek', anchor || null);
  S.week = w; S.draft = {}; S.dirty = {};
  w.days.forEach(d=>{
    const rows = d.lines.map(l=>({ t:l.t, c:l.hw, s:(l.hw && l.name && l.name!==l.t) ? l.name : '' }));
    rows.push({ t:'', c:true, s:'' });
    S.draft[d.date] = rows;
  });
}
function nextSchoolLabel(date){ const n = stepSchool(date,1); return md(n)+'（'+WD[dow(n)]+'）'; }
function dayCard(d){
  const rows = S.draft[d.date] || [];
  const isToday = d.date === S.week.today;
  let h = '<section class="card'+(isToday?' today':'')+'" data-day="'+d.date+'">';
  h += '<h3>週'+WD[dow(d.date)]+' '+md(d.date)+(isToday?' <span class="chip" style="background:var(--coral)">今天</span>':'')+'</h3>';
  rows.forEach((r,i)=>{
    h += '<div class="lrow" data-i="'+i+'">'+
      '<input class="in" data-f="t" value="'+esc(r.t)+'" placeholder="第 '+(i+1)+' 項聯絡簿內容" maxlength="80" enterkeyhint="next">'+
      '<button class="chk'+(r.c?' on':'')+'" data-act="chk" aria-pressed="'+r.c+'">'+(r.c?'☑ 隔天檢查':'☐ 不檢查')+'</button>'+
      '<button class="xbtn" data-act="del" aria-label="刪除這一項">✕</button>'+
      (r.c ? '<input class="in sm" data-f="s" value="'+esc(r.s)+'" placeholder="登記表上的簡稱（選填，預設用整句）" maxlength="30">' : '')+
    '</div>';
  });
  h += '<div class="sub" style="margin:4px 0 10px">勾選的項目會在 '+nextSchoolLabel(d.date)+' 自動出現在作業登記表。</div>';
  h += '<div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">'+
       '<button class="btn sm sky" data-act="add">＋新增一項</button>'+
       '<button class="btn sm green" data-act="save">儲存這天</button>'+
       '<span class="stxt" id="st_'+d.date+'">'+(S.dirty[d.date]?'尚未儲存':'')+'</span></div>';
  return h+'</section>';
}
function viewWeek(){
  if (!S.week) return '<div class="empty-ad">載入中…</div>';
  const curNotice = (S.board && S.board.notice) ? S.board.notice : '';
  let h = '<section class="card"><h3>📢 教室黑板便條（聯絡簿置頂提醒）</h3>'+
    '<div style="display:flex;gap:8px;flex-wrap:wrap">'+
    '<input class="in grow" id="noticeIn" value="'+esc(curNotice)+'" placeholder="例如：週五校外教學記得帶水壺、穿班服" maxlength="120" style="min-width:220px">'+
    '<button class="btn sm green" data-act="saveNotice">更新便條</button>'+
    '<button class="btn sm plain" data-act="clearNotice">清除</button></div></section>';
  const m = S.week.monday, f = addDays(m,4);
  h += '<div class="weeknav"><button class="btn sm plain" data-act="wprev">◀ 上週</button>'+
    '<div class="mid">'+md(m)+'（一）～ '+md(f)+'（五）</div>'+
    '<button class="btn sm plain" data-act="wnext">下週 ▶</button></div>'+
    '<div class="weekgrid">'+S.week.days.map(dayCard).join('')+'</div>';
  return h;
}
function setStTxt(date, txt){ const el = document.getElementById('st_'+date); if (el) el.textContent = txt; }
async function saveDay(date){
  const rows = (S.draft[date]||[]).filter(r=>r.t.trim()).map(r=>({ text:r.t.trim(), check:r.c, short:(r.s||'').trim() }));
  setStTxt(date,'儲存中…');
  try {
    await gs('saveHomework', date, rows);
    S.dirty[date] = false; S.lastWrite = Date.now(); S.writeSeq++;
    setStTxt(date,'已儲存 ✓ '+nowTime());
    fetchBoard(true);
    return true;
  } catch(e) { setStTxt(date,'儲存失敗'); handleErr(e); return false; }
}
async function saveAllDirty(){
  const ds = Object.keys(S.dirty).filter(d=>S.dirty[d]);
  for (const d of ds) await saveDay(d);
}
function focusRow(day, i){
  const el = document.querySelector('.card[data-day="'+day+'"] .lrow[data-i="'+i+'"] input[data-f="t"]');
  if (el) el.focus();
}

/* ---------- 分頁二：今日登記批改 ---------- */
function selectedItem(){
  const b = S.board; if (!b || !b.items.length) return null;
  let it = b.items.find(x=>x.source+'|'+x.name === S.sel);
  if (!it) { it = b.items[0]; S.sel = it.source+'|'+it.name; }
  return it;
}
function renderRegTop(){
  const el = $('#regTop'); if (!el) return;
  const b = S.board;
  if (!b) { el.innerHTML = '<div class="empty-ad">載入中…</div>'; return; }
  let h = '<section class="card"><h3>今日作業登記 '+md(b.date)+'（'+WD[dow(b.date)]+'）</h3>';
  if (!b.weekday) {
    h += '<div class="empty-ad"><svg><use href="#i-moon"/></svg>今天是假日，沒有要登記的作業</div></section>';
    el.innerHTML = h; return;
  }
  h += '<div class="note">自動帶入 <b>'+(b.source?md(b.source)+'（'+WD[dow(b.source)]+'）':'—')+'</b> 聯絡簿勾選的作業項目。</div>';
  let opts = '<option value="">自動：前一個上課日（'+md(b.srcAuto)+'）</option>';
  let d = b.date;
  for (let k=0;k<10;k++){ d = stepSchool(d,-1); opts += '<option value="'+d+'"'+(b.srcOverride && b.source===d?' selected':'')+'>'+md(d)+'（週'+WD[dow(d)]+'）聯絡簿</option>'; }
  h += '<details style="margin-bottom:12px"><summary class="sub" style="cursor:pointer;min-height:44px;display:flex;align-items:center">遇到放假或補課？更換作業來源日</summary>'+
       '<select class="in" id="srcSel" style="margin-top:8px">'+opts+'</select></details>';
  if (!b.items.length) h += '<div class="empty-ad" style="padding:14px"><svg><use href="#i-board"/></svg>目前沒有要檢查的項目<div class="sub">可到「一週排程」勾選前一天的聯絡簿項目，或按下方新增臨時項目</div></div>';
  else {
    const sel = selectedItem();
    h += '<div class="chips">'+b.items.map((it,i)=>{
      const total = b.students.length;
      const ok = b.students.filter(s=>{ const t = b.status[skey(it,s.seat)]; return t==='done' || t==='corrected'; }).length;
      return '<button class="chipsel'+(it===sel?' on':'')+'" data-act="sel" data-i="'+i+'">'+esc(it.name)+(it.temp?' <span class="chip" style="font-size:13px">臨</span>':'')+'<small>已完成 '+ok+' / '+total+'</small></button>';
    }).join('')+'</div>';
  }
  if (S.tempOpen) {
    h += '<div style="display:flex;gap:8px;flex-wrap:wrap"><input class="in grow" id="tempIn" placeholder="例如：數學考卷簽名、通知單回條" maxlength="40" style="min-width:200px">'+
         '<button class="btn sm green" data-act="tempgo">新增</button><button class="btn sm plain" data-act="tempno">取消</button></div>';
  } else {
    h += '<button class="btn" data-act="tempopen">＋臨時新增今日檢查項目</button>';
  }
  const sel2 = selectedItem();
  if (sel2 && sel2.temp) h += ' <button class="btn sm coral" data-act="tempdel">'+(S.delArm?'再按一次確認刪除':'刪除此臨時項目')+'</button>';
  h += '</section>';
  el.innerHTML = h;
  if (S.tempOpen) { const ti = $('#tempIn'); if (ti) ti.focus(); }
}
const MODES = [['done','已完成 ✓'],['unsubmitted','未交（紅號）'],['correction','待訂正（藍號）'],['corrected','訂正完成（藍號打叉）'],['cycle','輪流切換']];
function renderRegSeats(){
  const el = $('#regSeats'); if (!el) return;
  const b = S.board, it = selectedItem();
  if (!b || !b.weekday || !it) { el.innerHTML = ''; return; }
  let h = '<section class="card"><h3>「'+esc(it.name)+'」 點座號登記</h3>';
  h += '<div class="sub">先選一種狀態，再點座號（連點多位會自動合併極速同步）；同一個狀態再點一次＝清除回空白。</div>';
  h += '<div class="modes">'+MODES.map(m=>'<button class="mode'+(S.mode===m[0]?' on':'')+'" data-act="mode" data-m="'+m[0]+'">'+m[1]+'</button>').join('')+'</div>';
  h += '<div class="seats">'+b.students.map(s=>{
    const t = b.status[skey(it,s.seat)] || '';
    return '<button class="seatbtn" data-act="seat" data-seat="'+s.seat+'"><span class="ic">'+icon(t,s.seat)+'</span>'+
      '<span class="nmn">'+s.seat+' 號 '+esc(s.name)+'<span class="lbl">'+(LABEL[t]||'未登記')+'</span></span></button>';
  }).join('')+'</div>';
  h += '<div class="bulk"><button class="btn green" data-act="allDone">全班已完成</button><button class="btn plain" data-act="allReset">全班清除重設</button></div></section>';
  el.innerHTML = h;
}
function setLocal(it, seat, status){
  if (status) S.board.status[skey(it,seat)] = status;
  else delete S.board.status[skey(it,seat)];
}
function payload(it, seat, status){ return { due:S.board.date, source:it.source, name:it.name, seat:seat, status:status }; }
function applyStatuses(it, list){
  list.forEach(x=>setLocal(it,x[0],x[1]));
  queueStatusBatch(list.map(x=>payload(it,x[0],x[1])));
  S.lastJson = '';
  renderRegTop(); renderRegSeats();
}

/* ---------- 分頁三：欠交追蹤 ---------- */
function viewTrack(){
  const b = S.board; if (!b) return '<div class="empty-ad">載入中…</div>';
  if (!b.carry.length) return '<section class="card"><div class="empty-ad"><svg><use href="#i-star"/></svg>沒有未結案的欠交，大家都很棒！</div></section>';
  const total = b.carry.reduce((n,g)=>n+g.entries.length,0);
  let h = '<div class="note">共 <b>'+total+'</b> 筆未結案（紅號＝未交、藍號＝待訂正）。</div>';
  b.carry.forEach((g,gi)=>{
    h += '<section class="card tk"><h3>'+md(g.due)+'（週'+WD[dow(g.due)]+'）'+esc(g.name)+
         '<span class="sub"> '+(g.source!==g.due?'來自 '+md(g.source)+' 聯絡簿':'臨時項目')+'</span></h3>';
    g.entries.forEach(e=>{
      const stu = b.students.find(s=>s.seat===e.seat);
      h += '<div class="who"><span class="bw" style="--b:42px"><span class="badge '+(e.status==='unsubmitted'?'red':'blue')+'">'+e.seat+'</span></span>'+
        '<span class="wn">'+esc(stu?stu.name:'')+'<span class="sub"> '+LABEL[e.status]+'</span></span>'+
        (e.status==='unsubmitted'
          ? '<button class="btn sm green" data-act="tk" data-g="'+gi+'" data-seat="'+e.seat+'" data-to="done">補交完成 ✓</button><button class="btn sm sky" data-act="tk" data-g="'+gi+'" data-seat="'+e.seat+'" data-to="correction">改待訂正</button>'
          : '<button class="btn sm green" data-act="tk" data-g="'+gi+'" data-seat="'+e.seat+'" data-to="corrected">訂正完成 ✗</button>')+
        '</div>';
    });
    h += '<div style="margin-top:8px"><button class="btn sm plain" data-act="tkall" data-g="'+gi+'">這一項全部結案</button></div></section>';
  });
  return h;
}
function tkApply(gi, list){
  const b = S.board, g = b.carry[gi]; if (!g) return;
  const it = { source:g.source, name:g.name };
  list.forEach(x=>{
    const e = g.entries.find(y=>y.seat===x[0]); if (!e) return;
    if (x[1]==='done' || x[1]==='corrected') g.entries = g.entries.filter(y=>y!==e);
    else e.status = x[1];
  });
  if (!g.entries.length) b.carry.splice(gi,1);
  S.lastJson = '';
  queueStatusBatch(list.map(x=>({ due:g.due, source:it.source, name:it.name, seat:x[0], status:x[1] })));
  renderAdmin();
}

/* ---------- 分頁四：額外獎勵抽獎、課堂加減分與積分歸零 ---------- */
const PT_REASONS = ['發表踴躍','秩序良好','熱心助人','小組合作','提醒扣分'];
function viewPoints(){
  const b = S.board; if (!b) return '<div class="empty-ad">載入中…</div>';
  const sc = b.scoreTotal || {};

  let h = '<section class="card" style="background:#FFF8E1"><h3>🌟 老師額外獎勵：發放星星抽獎機會</h3>';
  h += '<div class="sub" style="margin-bottom:10px">點選全班或個別學生按鈕後，前台名字後方會<b>重新變回閃亮星星 ⭐</b>，可再次點擊抽獎！</div>';
  h += '<div style="margin-bottom:12px"><button class="btn green" data-act="grantLottoAll">🌟 全班每人再抽獎一次</button></div>';
  h += '<div class="seats">';
  b.students.forEach(s => {
    const ready = canDraw(s.seat);
    const drew = (b.lotteryToday && b.lotteryToday[s.seat]) || 0;
    h += '<button class="seatbtn'+(ready?' picked':'')+'" data-act="grantLotto" data-seat="'+s.seat+'">'+
      '<span class="nmn">'+s.seat+' 號 '+esc(s.name)+
      '<span class="lbl">'+(ready ? '⭐ 可抽獎中' : (drew ? '已抽 +'+drew+'分 (點我再抽)' : '點我獎勵抽獎'))+'</span></span></button>';
  });
  h += '</div></section>';

  h += '<section class="card"><h3>⭐ 課堂加減分</h3>';
  h += '<div class="sub" style="margin-bottom:8px">步驟 1：選取學生（可單選或全選）</div>';
  h += '<div class="chips">';
  h += '<button class="btn sm plain" data-act="ptAll">全選全班</button>';
  h += '<button class="btn sm plain" data-act="ptClear">取消全選</button>';
  h += '</div><div class="seats">';
  b.students.forEach(s => {
    const on = S.ptSeats.has(s.seat);
    h += '<button class="seatbtn'+(on?' picked':'')+'" data-act="ptSeat" data-seat="'+s.seat+'">'+
      '<span class="nmn">'+s.seat+' 號 '+esc(s.name)+'<span class="lbl">目前 '+(sc[s.seat]||0)+' 分</span></span></button>';
  });
  h += '</div>';
  h += '<div class="sub" style="margin:14px 0 8px">步驟 2：選擇原因並加減分</div>';
  h += '<div class="chips">' + PT_REASONS.map(r =>
    '<button class="chk'+(S.ptReason===r?' on':'')+'" data-act="ptRsn" data-r="'+esc(r)+'">'+esc(r)+'</button>'
  ).join('') + '</div>';
  h += '<input class="in" id="ptReasonIn" value="'+esc(S.ptReason)+'" placeholder="或自行輸入原因" maxlength="40" style="margin-bottom:12px">';
  h += '<div class="bulk">' +
    [1,2,3,5].map(d => '<button class="btn green" data-act="ptGo" data-d="'+d+'">+'+d+' 分</button>').join('') +
    [-1,-2].map(d => '<button class="btn coral" data-act="ptGo" data-d="'+d+'">'+d+' 分</button>').join('') +
    '</div>';

  h += '<div style="margin-top:20px;padding-top:14px;border-top:2px dashed rgba(62,58,57,.3)">'+
    '<button class="btn coral" data-act="resetScores">'+(S.resetArm ? '⚠️ 再按一次確認「清空全班所有積分」' : '🔄 全班積分歸零（重新計算）')+'</button>'+
    '<div class="sub" style="margin-top:6px">會清空所有加減分與抽獎累計紀錄，讓全班從 0 分重新開始。</div></div>';
  h += '</section>';

  if (b.pointLogs && b.pointLogs.length) {
    h += '<section class="card"><h3>📝 最近加減分紀錄</h3>';
    b.pointLogs.forEach(l => {
      h += '<div style="display:flex;justify-content:space-between;padding:6px 0;border-bottom:2px dotted rgba(62,58,57,.2)">'+
        '<span><b>'+l.seat+'號 '+esc(l.name)+'</b> · '+esc(l.reason)+'</span>'+
        '<span style="font-weight:700;color:'+(l.delta>0?'var(--tickgreen)':'var(--red)')+'">'+(l.delta>0?'+'+l.delta:l.delta)+' 分</span></div>';
    });
    h += '</section>';
  }

  return h;
}

/* =====================================================
 * 後台事件（事件委派）
 * ===================================================== */
const adBody = $('#adBody');
adBody.addEventListener('input', ev=>{
  if (ev.target.id === 'ptReasonIn') { S.ptReason = ev.target.value; return; }
  const row = ev.target.closest('.lrow'); if (!row) return;
  const day = row.closest('.card').dataset.day, i = +row.dataset.i, f = ev.target.dataset.f;
  if (!f) return;
  S.draft[day][i][f === 't' ? 't' : 's'] = ev.target.value;
  S.dirty[day] = true; setStTxt(day,'尚未儲存');
});
adBody.addEventListener('keydown', ev=>{
  if (ev.key !== 'Enter' || !ev.target.matches('input[data-f="t"]')) return;
  ev.preventDefault();
  const row = ev.target.closest('.lrow'), day = row.closest('.card').dataset.day, i = +row.dataset.i;
  const rows = S.draft[day];
  if (i === rows.length-1) { rows.push({t:'',c:true,s:''}); renderAdmin(); }
  focusRow(day, i+1);
});
adBody.addEventListener('change', async ev=>{
  if (ev.target.id === 'srcSel') {
    try { await gs('setSource', S.board.date, ev.target.value); S.writeSeq++; S.lastJson=''; await fetchBoard(true); renderAdmin(); toast('已更換作業來源'); }
    catch(e){ handleErr(e); }
  }
});
adBody.addEventListener('click', async ev=>{
  const btn = ev.target.closest('[data-act]'); if (!btn) return;
  const act = btn.dataset.act;
  const card = btn.closest('.card');
  const day = card && card.dataset.day;

  if (act === 'saveNotice' || act === 'clearNotice') {
    const val = act === 'clearNotice' ? '' : ($('#noticeIn').value || '').trim();
    btn.disabled = true;
    try {
      await gs('saveNotice', val);
      S.writeSeq++; S.lastJson = '';
      await fetchBoard(true);
      renderAdmin();
      toast(val ? '已更新黑板便條' : '已清除黑板便條');
    } catch(e){ handleErr(e); }
    btn.disabled = false;
    return;
  }

  if (act === 'chk') { const i = +btn.closest('.lrow').dataset.i; const r = S.draft[day][i]; r.c = !r.c; S.dirty[day] = true; renderAdmin(); return; }
  if (act === 'del') { const i = +btn.closest('.lrow').dataset.i; S.draft[day].splice(i,1); if (!S.draft[day].length) S.draft[day].push({t:'',c:true,s:''}); S.dirty[day] = true; renderAdmin(); return; }
  if (act === 'add') { S.draft[day].push({t:'',c:true,s:''}); renderAdmin(); focusRow(day, S.draft[day].length-1); return; }
  if (act === 'save') { btn.disabled = true; const ok = await saveDay(day); btn.disabled = false; if (ok) toast('已儲存 '+md(day)); return; }
  if (act === 'wprev' || act === 'wnext') {
    await saveAllDirty();
    try { await loadWeek(addDays(S.week.monday, act==='wprev'?-7:7)); } catch(e){ handleErr(e); }
    renderAdmin(); return;
  }

  if (act === 'sel') { await flushStatusBuffer(); const it = S.board.items[+btn.dataset.i]; S.sel = it.source+'|'+it.name; S.delArm = false; renderRegTop(); renderRegSeats(); return; }
  if (act === 'mode') { S.mode = btn.dataset.m; renderRegSeats(); return; }
  if (act === 'seat') {
    const it = selectedItem(); if (!it) return;
    const seat = +btn.dataset.seat, cur = S.board.status[skey(it,seat)] || '';
    let nx;
    if (S.mode === 'cycle') nx = NEXT[cur] !== undefined ? NEXT[cur] : 'done';
    else nx = (cur === S.mode) ? '' : S.mode;
    applyStatuses(it, [[seat,nx]]);
    const nb = $('#regSeats .seatbtn[data-seat="'+seat+'"] .ic'); if (nb) nb.classList.add('pop');
    return;
  }
  if (act === 'allDone' || act === 'allReset') {
    const it = selectedItem(); if (!it) return;
    applyStatuses(it, S.board.students.map(s=>[s.seat, act==='allDone'?'done':'']));
    return;
  }
  if (act === 'tempopen') { S.tempOpen = true; renderRegTop(); return; }
  if (act === 'tempno')   { S.tempOpen = false; renderRegTop(); return; }
  if (act === 'tempgo') {
    const name = ($('#tempIn').value||'').trim(); if (!name) { toast('請輸入項目名稱'); return; }
    btn.disabled = true;
    try {
      await flushStatusBuffer();
      await gs('addTempItem', S.board.date, name);
      S.writeSeq++; S.lastJson=''; S.tempOpen = false; S.sel = S.board.date+'|'+name;
      await fetchBoard(true); renderAdmin(); toast('已新增臨時項目');
    } catch(e) { handleErr(e); btn.disabled = false; }
    return;
  }
  if (act === 'tempdel') {
    if (!S.delArm) { S.delArm = true; renderRegTop(); setTimeout(()=>{ if (S.delArm) { S.delArm=false; if (S.tab==='register') renderRegTop(); } }, 3500); return; }
    const it = selectedItem(); S.delArm = false;
    try { await flushStatusBuffer(); await gs('removeTempItem', S.board.date, it.name); S.writeSeq++; S.sel = null; S.lastJson=''; await fetchBoard(true); renderAdmin(); toast('已刪除臨時項目'); }
    catch(e){ handleErr(e); }
    return;
  }

  if (act === 'tk') { tkApply(+btn.dataset.g, [[+btn.dataset.seat, btn.dataset.to]]); return; }
  if (act === 'tkall') {
    const g = S.board.carry[+btn.dataset.g]; if (!g) return;
    tkApply(+btn.dataset.g, g.entries.map(e=>[e.seat, e.status==='unsubmitted'?'done':'corrected']));
    return;
  }

  if (act === 'grantLotto') {
    const seat = +btn.dataset.seat;
    btn.disabled = true;
    try {
      const res = await gs('grantExtraLottery', seat);
      S.writeSeq++; S.lastJson = '';
      await fetchBoard(true);
      renderAdmin();
      toast('⭐ 已發放抽獎機會給 ' + seat + ' 號 ' + (res.name || '') + '！');
    } catch(e){ handleErr(e); }
    btn.disabled = false;
    return;
  }
  if (act === 'grantLottoAll') {
    btn.disabled = true;
    try {
      const res = await gs('grantAllExtraLottery');
      S.writeSeq++; S.lastJson = '';
      await fetchBoard(true);
      renderAdmin();
      toast('🌟 已給予全班 ' + (res.count || '') + ' 位同學再抽獎一次！');
    } catch(e){ handleErr(e); }
    btn.disabled = false;
    return;
  }

  if (act === 'ptSeat') { const s = +btn.dataset.seat; S.ptSeats.has(s)?S.ptSeats.delete(s):S.ptSeats.add(s); renderAdmin(); return; }
  if (act === 'ptAll') { S.board.students.forEach(s=>S.ptSeats.add(s.seat)); renderAdmin(); return; }
  if (act === 'ptClear') { S.ptSeats.clear(); renderAdmin(); return; }
  if (act === 'ptRsn') { S.ptReason = btn.dataset.r; renderAdmin(); return; }
  if (act === 'ptGo') {
    if (!S.ptSeats.size) { toast('請先點選要加減分的學生'); return; }
    const delta = +btn.dataset.d;
    const reason = ($('#ptReasonIn').value || '').trim() || S.ptReason;
    btn.disabled = true;
    try {
      await gs('addPoints', [...S.ptSeats], delta, reason);
      S.ptSeats.clear(); S.writeSeq++; S.lastJson = '';
      await fetchBoard(true); renderAdmin();
      toast('已記錄 '+(delta>0?'+'+delta:delta)+' 分！');
    } catch(e){ handleErr(e); }
    btn.disabled = false;
    return;
  }
  if (act === 'resetScores') {
    if (!S.resetArm) {
      S.resetArm = true;
      renderAdmin();
      setTimeout(() => { if (S.resetArm) { S.resetArm = false; if (S.tab === 'points') renderAdmin(); } }, 4000);
      return;
    }
    S.resetArm = false;
    btn.disabled = true;
    try {
      await gs('resetAllScores');
      S.ptSeats.clear(); S.writeSeq++; S.lastJson = '';
      await fetchBoard(true); renderAdmin();
      toast('🔄 全班積分已全部歸零！');
    } catch(e){ handleErr(e); }
    btn.disabled = false;
    return;
  }
});

renderLegend();
const hasSnap = bootFromLocalSnap();
fetchBoard(!hasSnap);
</script>
</body>
